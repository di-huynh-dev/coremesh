{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "next-env.d.ts", ".next/types/**/*.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
