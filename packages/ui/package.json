{
  "name": "@repo/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./styles.css": "./dist/index.css",
    "./types/post": {
      "types": "./dist/types/post.d.ts",
      "default": "./dist/types/post.js"
    },
    "./post-card": {
      "types": "./dist/post-card.d.ts",
      "default": "./dist/post-card.js"
    },
    "./post-list": {
      "types": "./dist/post-list.d.ts",
      "default": "./dist/post-list.js"
    },
    "./featured-posts": {
      "types": "./dist/featured-posts.d.ts",
      "default": "./dist/featured-posts.js"
    },
    "./post-filters": {
      "types": "./dist/post-filters.d.ts",
      "default": "./dist/post-filters.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "types/post": [
        "./dist/types/post.d.ts"
      ],
      "post-card": [
        "./dist/post-card.d.ts"
      ],
      "post-list": [
        "./dist/post-list.d.ts"
      ],
      "featured-posts": [
        "./dist/featured-posts.d.ts"
      ],
      "post-filters": [
        "./dist/post-filters.d.ts"
      ],
      "*": [
        "./dist/*.d.ts"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
    "build:components": "tsc",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "peerDependencies": {
    "react": "^19",
    "next": "^16",
    "framer-motion": "^12",
    "lucide-react": "^0.562.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/tailwind-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/cli": "^4.1.5",
    "@types/react": "^19.1.0",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.5",
    "typescript": "5.9.2"
  }
}
