# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Blog origin (no locale). Defaults to https://nextdi.io.vn
NEXT_PUBLIC_BLOGS_URL=http://localhost:3002

# Contact form email (Nodemailer + Gmail SMTP, free).
# SMTP_PASS is a Google App Password: Google Account → Security → 2-Step Verification → App passwords.
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO=dihuynhdev.contact@gmail.com

# Cloudflare Turnstile (free CAPTCHA): https://dash.cloudflare.com → Turnstile → Add widget.
# Leave both empty to disable the widget and the server check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
